# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/security_monitoring

# PostgreSQL container credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=security_monitoring

# CORS (comma-separated origins — include your public IP if accessed externally)
CORS_ORIGINS=http://localhost:3000,http://localhost

# Detection settings
MODEL_PATH=yolo11n.pt
CONFIDENCE_THRESHOLD=0.45
DEVICE=auto

# Video source: "webcam" or "sample_video"
SOURCE_MODE=webcam
CAMERA_INDEX=0

# Retention
RETENTION_DAYS=7

# Optional: auto-start pipeline with a demo video on boot
# DEMO_VIDEO_PATH=/app/backend/demo1.mp4

# AWS Bedrock AI Compliance Assistant (optional — system works without it)
# Set AWS_BEDROCK_ENABLED=true to activate AI analysis
AWS_BEDROCK_ENABLED=false
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_BEDROCK_MAX_TOKENS=300
AWS_BEDROCK_TEMPERATURE=0.3
AWS_BEDROCK_CACHE_TTL=120

# AWS credentials (use IAM roles on EC2 instead of keys when possible)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
