# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/security_monitoring

# PostgreSQL container credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=security_monitoring

# CORS (comma-separated origins — include your public IP if accessed externally)
CORS_ORIGINS=http://localhost:3000,http://localhost

# Detection settings
MODEL_PATH=yolo11n.pt
CONFIDENCE_THRESHOLD=0.40
DEVICE=auto

# Video source: "webcam" or "sample_video"
SOURCE_MODE=webcam
CAMERA_INDEX=0

# Retention
RETENTION_DAYS=7

# Optional: auto-start pipeline with a demo video on boot
# DEMO_VIDEO_PATH=/app/backend/demo1.mp4
