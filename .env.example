# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/security_monitoring

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost,http://localhost:3000

# Detection settings
MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.40
DEVICE=auto

# Video source: "webcam" or "sample_video"
SOURCE_MODE=webcam
CAMERA_INDEX=0

# Retention
RETENTION_DAYS=7
